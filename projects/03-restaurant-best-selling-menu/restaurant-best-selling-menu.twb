      <table>
        <view>
          <datasources>
            <datasource caption='RawData (raw data)' name='federated.03pp2v215nluaf1gqeq7l0tl4bgx' />
          </datasources>
          <datasource-dependencies datasource='federated.03pp2v215nluaf1gqeq7l0tl4bgx'>
            <column datatype='string' name='[Item Name]' role='dimension' type='nominal' />
            <column datatype='integer' name='[Item amount]' role='measure' type='quantitative' />
            <column datatype='string' name='[Receipt No]' role='dimension' type='nominal' />
            <column-instance column='[Item Name]' derivation='None' name='[none:Item Name:nk]' pivot='key' type='nominal' />
            <column-instance column='[Receipt No]' derivation='None' name='[none:Receipt No:nk]' pivot='key' type='nominal' />
